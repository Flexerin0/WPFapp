<Window x:Class="WpfApp1.FormConnection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="FormConnection" Height="400" Width="400">
    <Grid Background="#FF99B4D1">

        <!-- Заголовок -->
        <Label Content="Сервер БД"
           HorizontalAlignment="Center"
           Margin="0,10,0,0"
           VerticalAlignment="Top"
           FontSize="18"/>

        <!-- Сервер -->
        <ComboBox x:Name="cBoxServer"
              HorizontalAlignment="Center"
              Margin="0,40,0,0"
              VerticalAlignment="Top"
              Width="300"
              Height="26"/>

        <!-- Логин -->
        <Label Content="Логин"
           Margin="40,90,0,0"
           VerticalAlignment="Top"
           FontSize="20"/>

        <TextBox x:Name="tBoxLogin"
             Margin="160,90,40,0"
             Height="34"
             VerticalAlignment="Top"
             FontSize="18"/>

        <!-- Пароль -->
        <Label Content="Пароль"
           Margin="40,140,0,0"
           VerticalAlignment="Top"
           FontSize="20"/>

        <TextBox x:Name="tBoxPassword"
                 Margin="160,140,40,0"
                 Height="34"
                 VerticalAlignment="Top"
                 FontSize="18"/>

        <!-- Запомнить -->
        <CheckBox x:Name="cBoxRememberMe"
              Content="Запомнить пароль"
              Margin="160,190,0,0"
              VerticalAlignment="Top"/>

        <!-- Сообщения -->
        <TextBlock x:Name="labelError"
               Margin="20,230,20,0"
               VerticalAlignment="Top"
               TextAlignment="Center"
               FontSize="14"
               Foreground="Gray"/>

        <!-- Кнопки -->
        <Button Content="Проверка"
            Width="160"
            Height="32"
            Margin="40,270,200,0"
            VerticalAlignment="Top"
            Click="BtnCheck_Click"/>

        <Button Content="Создать БД"
            x:Name="btnCreateDb"
            Width="160"
            Height="32"
            Margin="200,270,0,0"
            VerticalAlignment="Top"
            IsEnabled="False"
            Click="BtnCreateDB_Click"/>

        <Button Content="Подключение"
            x:Name="btnConnect"
            Width="160"
            Height="32"
            Margin="40,310,200,0"
            VerticalAlignment="Top"
            IsEnabled="False"
            Click="BtnConnect_Click"/>

        <Button Content="Выход"
            Width="160"
            Height="32"
            Margin="200,310,0,0"
            VerticalAlignment="Top"
            Click="BtnExit_Click"/>
        <ComboBox x:Name="cbRole" Margin="151,227,0,0" VerticalAlignment="Top" Width="120">
            <ComboBoxItem Content="Seller"/>
            <ComboBoxItem Content="Manager"/>
            <ComboBoxItem Content="Admin"/>
        </ComboBox>

    </Grid>
</Window>
