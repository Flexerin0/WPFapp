<Window x:Class="WpfApp1.FormMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="FormMain" Height="470" Width="880">
    <Grid Background="#FF99B4D1">
        <Canvas Margin="0,1,0,433" Height="20" Background="#FFCECECE">
            <Button Content="Выход"
                Width="70"
                Height="20"
                Click="BtnExit_Click" Canvas.Left="800" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Button x:Name="btnReports" Content="Отчёты"
                Width="70"
                Height="20"
                Click="BtnReports_Click" Canvas.Left="725" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Button x:Name="btnBackup" Content="Бэкапы"
                Width="70"
                Height="20"
                Click="BtnBackup_Click" Canvas.Left="650" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        </Canvas>
        <ComboBox x:Name="cbDirectories" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120" Height="20" SelectionChanged="Directories_SelectionChanged">
            <ComboBoxItem Content="Сотрудники"/>
            <ComboBoxItem Content="Клиенты"/>
            <ComboBoxItem Content="Товары"/>
            <ComboBoxItem Content="Поставщики"/>
        </ComboBox>
        <Border BorderBrush="Black" BorderThickness="1" Margin="34,31,1410,383" Height="40" Width="250" Background="#FF7A82F6">
            <Label Content="Приход товара" FontSize="20" HorizontalAlignment="Center"/>
        </Border>
        <Label Content="Товар" HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label Content="Поставщик" HorizontalAlignment="Left" Margin="10,101,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label Content="Количество" HorizontalAlignment="Left" Margin="10,132,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label Content="Цена за единицу" HorizontalAlignment="Left" Margin="10,163,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label Content="Описание" HorizontalAlignment="Left" Margin="329,40,0,0" VerticalAlignment="Top" FontSize="16"/>
        <ComboBox x:Name="cbReceiptProduct" HorizontalAlignment="Left" Margin="164,76,0,0" VerticalAlignment="Top" Width="120" Height="26"/>
        <ComboBox x:Name="cbReceiptSupplier" HorizontalAlignment="Left" Margin="164,107,0,0" VerticalAlignment="Top" Width="120" Height="26"/>
        <TextBox x:Name="tbReceiptQuantity" HorizontalAlignment="Left" Margin="164,138,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="24" Background="#FFE5E5E5"/>
        <TextBox x:Name="tbReceiptPrice" HorizontalAlignment="Left" Margin="164,167,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="24" Background="#FFE5E5E5"/>
        <TextBox x:Name="tbReceiptDescription" HorizontalAlignment="Left" Margin="305,76,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="131" Height="87" Background="#FFE5E5E5"/>
        <DataGrid x:Name="dgReceipts" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="441,31,10,215"/>
        <Label Content="Товар" HorizontalAlignment="Left" Margin="10,274,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label Content="Клиент" HorizontalAlignment="Left" Margin="10,305,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label Content="Количество" HorizontalAlignment="Left" Margin="10,336,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label Content="Цена за единицу" HorizontalAlignment="Left" Margin="10,367,0,0" VerticalAlignment="Top" FontSize="16"/>
        <ComboBox x:Name="cbSaleProduct" HorizontalAlignment="Left" Margin="164,280,0,0" VerticalAlignment="Top" Width="120" Height="26"/>
        <ComboBox x:Name="cbSaleClient" HorizontalAlignment="Left" Margin="164,311,0,0" VerticalAlignment="Top" Width="120" Height="26"/>
        <TextBox x:Name="tbSaleQuantity" HorizontalAlignment="Left" Margin="164,342,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="24" Background="#FFE5E5E5"/>
        <TextBox x:Name="tbSalePrice" HorizontalAlignment="Left" Margin="164,371,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="24" Background="#FFE5E5E5"/>
        <Border BorderBrush="Black" BorderThickness="1" Margin="34,224,1410,190" Height="40" Width="250" Background="#FF7A82F6">
            <Label Content="Продажа" FontSize="20" HorizontalAlignment="Center"/>
        </Border>
        <Label Content="Скидка (%)" HorizontalAlignment="Left" Margin="10,398,0,0" VerticalAlignment="Top" FontSize="16"/>
        <TextBox x:Name="tbSaleDiscount" HorizontalAlignment="Left" Margin="164,402,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="24" Background="#FFE5E5E5"/>
        <Button x:Name="btnAddReceipt" Click="btnAddReceipt_Click" Content="Оформить приход" HorizontalAlignment="Left" Margin="305,169,0,0" VerticalAlignment="Top" Height="30" Width="131" Background="#FF7A82F6" FontSize="14" FontWeight="Bold"/>
        <Button x:Name="btnAddSale" Click="btnAddSale_Click" Content="Продать" HorizontalAlignment="Left" Margin="305,336,0,0" VerticalAlignment="Top" Height="30" Width="131" Background="#FF7A82F6" FontSize="14" FontWeight="Bold"/>
        <DataGrid x:Name="dgSales" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="442,244,10,10"/>
        <Label x:Name="lblProductStock" Content="Остаток товара" HorizontalAlignment="Left" Margin="107,73,0,0" VerticalAlignment="Top" FontSize="16" Width="51"/>

    </Grid>
</Window>
