<Window x:Class="WpfApp1.FormStockReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="FormStockReport" Height="475" Width="815">
    <Grid Background="#FF99B4D1">
        <Border BorderBrush="Black" BorderThickness="1" Margin="0,0,0,402" Background="#FF5B92CE">
            <Label Content="Отчёт: Остатки товаров на складе" HorizontalAlignment="Left" VerticalAlignment="Center" Width="198" Margin="9,0,0,0"/>
        </Border>
        <Button x:Name="btnGenerateReport" Click="btnGenerateReport_Click" Content="Сформировать отчёт" HorizontalAlignment="Left" Margin="209,6,0,0" VerticalAlignment="Top" Height="21" Width="112" Background="#FF7A82F6" FontSize="10" FontWeight="Bold"/>
        <Button x:Name="btnRefreshReport" Click="btnRefreshReport_Click" Content="Обновить" HorizontalAlignment="Left" Margin="326,6,0,0" VerticalAlignment="Top" Height="21" Width="74" Background="#FF7A82F6" FontSize="10" FontWeight="Bold"/>
        <ComboBox x:Name="cbCategoryFilter" HorizontalAlignment="Left" Margin="449,5,0,0" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="tbSearch" HorizontalAlignment="Left" Margin="574,6,0,0" TextWrapping="Wrap" Text="Поиск" VerticalAlignment="Top" Width="137" Height="22"/>
        <Button x:Name="btnSearch" Click="btnSearch_Click" Content="Поиск" HorizontalAlignment="Left" Margin="716,6,0,0" VerticalAlignment="Top" Height="21" Width="74" Background="#FF7A82F6" FontSize="10" FontWeight="Bold"/>
        <DataGrid x:Name="dgStockReport" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,33,0,32"/>
        <Border BorderBrush="Black" BorderThickness="1" Margin="0,402,0,0" Background="#FF5B92CE"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,410,0,0" TextWrapping="Wrap" Text="Общее количество позиций:" VerticalAlignment="Top"/>
        <TextBlock x:Name="txtTotalProducts" HorizontalAlignment="Left" Margin="173,410,0,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="242,410,0,0" TextWrapping="Wrap" Text="Общая стоимость остатков:" VerticalAlignment="Top"/>
        <TextBlock x:Name="txtTotalStockValue" HorizontalAlignment="Left" Margin="399,410,0,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
        <Button x:Name="btnExit" Click="btnExit_Click" Content="Выход" HorizontalAlignment="Left" Margin="708,403,0,0" VerticalAlignment="Top" Height="29" Width="90" Background="#FF7A82F6" FontSize="14" FontWeight="Bold"/>

    </Grid>
</Window>
