<Window x:Class="WpfApp1.FormDatabaseBackup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="FormDatabaseBackup" Height="475" Width="350">
    <Grid Background="#FF99B4D1">
        <TextBox x:Name="tbBackupPath" HorizontalAlignment="Left" Margin="73,93,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="185" Height="22"/>
        <Border BorderBrush="Black" BorderThickness="1" Margin="27,12,23,372" Width="300" Height="50" Background="#FF5B92CE">
            <Label Content="Резервное копирование базы данных" HorizontalAlignment="Center" VerticalAlignment="Center" Width="222"/>
        </Border>
        <Label Content="путь к .bak файлу" HorizontalAlignment="Left" Margin="73,67,0,0" VerticalAlignment="Top" Width="105"/>
        <Button x:Name="btnBrowseBackup" Click="btnBrowseBackup_Click" Content="Обзор..." HorizontalAlignment="Left" Margin="194,69,0,0" VerticalAlignment="Top" Height="21" Width="56" Background="#FF7A82F6" FontSize="10" FontWeight="Bold"/>
        <Button x:Name="btnCreateBackup" Click="btnCreateBackup_Click" Content="Создать резервную копию" HorizontalAlignment="Left" Margin="90,126,0,0" VerticalAlignment="Top" Height="21" Width="150" Background="#FF7A82F6" FontSize="10" FontWeight="Bold"/>
        <Label Content="Статус:" HorizontalAlignment="Left" Margin="27,159,0,0" VerticalAlignment="Top"/>
        <Border BorderBrush="Black" BorderThickness="1" Margin="28,190,22,194" Width="300" Height="50" Background="#FF5B92CE">
            <Label Content="Восстановаление базы данных" HorizontalAlignment="Center" VerticalAlignment="Center" Width="182"/>
        </Border>
        <TextBox x:Name="tbRestorePath" HorizontalAlignment="Left" Margin="73,278,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="185" Height="22"/>
        <Label Content="путь к .bak файлу" HorizontalAlignment="Left" Margin="73,252,0,0" VerticalAlignment="Top" Width="105"/>
        <Button x:Name="btnBrowseRestore" Click="btnBrowseRestore_Click" Content="Обзор..." HorizontalAlignment="Left" Margin="194,254,0,0" VerticalAlignment="Top" Height="21" Width="56" Background="#FF7A82F6" FontSize="10" FontWeight="Bold"/>
        <Button x:Name="btnRestoreDatabase" Click="btnRestoreDatabase_Click" Content="Восстановить базу данных" HorizontalAlignment="Left" Margin="90,313,0,0" VerticalAlignment="Top" Height="21" Width="150" Background="#FF7A82F6" FontSize="10" FontWeight="Bold"/>
        <Button x:Name="btnExit" Click="btnExit_Click" Content="Выход" HorizontalAlignment="Left" Margin="284,403,0,0" VerticalAlignment="Top" Height="21" Width="56" Background="#FF7A82F6" FontSize="10" FontWeight="Bold"/>
        <TextBlock x:Name="txtRestoreStatus" HorizontalAlignment="Left" Margin="52,361,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Background="White" Width="226" Height="22"/>
        <TextBlock x:Name="txtBackupStatus" HorizontalAlignment="Left" Margin="74,164,0,0" TextWrapping="Wrap" VerticalAlignment="Top"/>

    </Grid>
</Window>
