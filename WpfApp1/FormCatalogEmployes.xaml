<Window x:Class="WpfApp1.FormCatalogEmployes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="FormCatalogEmployes" Height="470" Width="815">
    <Grid Background="#FF99B4D1">
        <Button Content="Редактировать" Click="BtnUpdate_Click" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Height="30" Width="370" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Button Content="Добавить" Click="BtnAdd_Click" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="30" Width="200" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Button Content="Удалить" HorizontalAlignment="Left" Margin="590,10,0,0" VerticalAlignment="Top" Height="30" Width="200" Background="#FF7A82F6" FontSize="18" FontWeight="Bold" Click="Button_Click_1"/>
        <Button Content="Сохранить и выйти" HorizontalAlignment="Left" Margin="10,394,0,0" VerticalAlignment="Top" Height="30" Width="370" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Button Content="Применить" Click="BtnSave_Click" HorizontalAlignment="Left" Margin="385,394,0,0" VerticalAlignment="Top" Height="30" Width="200" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Button Content="Выход" Click="BtnExit_Click" HorizontalAlignment="Left" Margin="590,394,0,0" VerticalAlignment="Top" Height="30" Width="200" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <TextBox HorizontalAlignment="Left" x:Name="tBoxId" Margin="160,45,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="220" Background="#FF68ADFF" Height="20"/>
        <TextBox HorizontalAlignment="Left" x:Name="tBoxFio" Margin="160,70,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="220" Background="#FF68ADFF" Height="20"/>
        <TextBox HorizontalAlignment="Left" x:Name="tBoxLogin" Margin="160,95,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="220" Background="#FF68ADFF" Height="20"/>
        <TextBox HorizontalAlignment="Left" x:Name="tBoxPassword" Margin="160,120,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="220" Background="#FF68ADFF" Height="20"/>
        <DatePicker HorizontalAlignment="Left" x:Name="dpBirthDate" Margin="160,145,0,0" VerticalAlignment="Top" Width="220"/>
        <TextBox HorizontalAlignment="Left" x:Name="tBoxPhone" Margin="160,174,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="220" Background="#FF68ADFF" Height="20"/>
        <TextBox HorizontalAlignment="Left" x:Name="tBoxEmail" Margin="160,199,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="220" Background="#FF68ADFF" Height="20"/>
        <Label Content="Id" HorizontalAlignment="Left" Margin="20,42,0,0" VerticalAlignment="Top" Width="135" FontWeight="Bold" FontSize="14"/>
        <Label Content="ФИО" HorizontalAlignment="Left" Margin="20,67,0,0" VerticalAlignment="Top" Width="135" FontWeight="Bold" FontSize="14"/>
        <Label Content="Логин" HorizontalAlignment="Left" Margin="20,92,0,0" VerticalAlignment="Top" Width="135" FontWeight="Bold" FontSize="14"/>
        <Label Content="Пароль" HorizontalAlignment="Left" Margin="20,117,0,0" VerticalAlignment="Top" Width="135" FontWeight="Bold" FontSize="14"/>
        <Label Content="Дата рождения" HorizontalAlignment="Left" Margin="20,144,0,0" VerticalAlignment="Top" Width="135" FontWeight="Bold" FontSize="14"/>
        <Label Content="Телефон" HorizontalAlignment="Left" Margin="20,171,0,0" VerticalAlignment="Top" Width="135" FontWeight="Bold" FontSize="14"/>
        <Label Content="Email" HorizontalAlignment="Left" Margin="20,196,0,0" VerticalAlignment="Top" Width="135" FontWeight="Bold" FontSize="14"/>
        <TextBox HorizontalAlignment="Left" x:Name="tBoxNote" Margin="385,67,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="405" Background="#FF68ADFF" Height="73"/>
        <Label Content="Примечание" HorizontalAlignment="Left" Margin="520,33,0,0" VerticalAlignment="Top" Width="135" FontSize="20" Background="#00000000" FontWeight="Bold"/>
        <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="IBoxEmployees" Margin="10,255,10,45" Background="#FF68ADFF" SelectionChanged="ListBox_SelectionChanged" IsSynchronizedWithCurrentItem="True" DisplayMemberPath="Login"/>
        <Button x:Name="btnImgPrev_Click" Content="&lt;" HorizontalAlignment="Left" Margin="581,186,0,0" VerticalAlignment="Top" Height="26" Width="52" Background="#FF7A82F6" FontSize="14" FontWeight="Bold" Click="BtnImgPrev_Click"/>
        <Button x:Name="btnImgNext_Click"  Content="&gt;" HorizontalAlignment="Left" Margin="638,186,0,0" VerticalAlignment="Top" Height="26" Width="52" Background="#FF7A82F6" FontSize="14" FontWeight="Bold" Click="BtnImgNext_Click"/>
        <Button x:Name="btnImgFirst_Click" Content="&lt;&lt;" HorizontalAlignment="Left" Margin="581,217,0,0" VerticalAlignment="Top" Height="26" Width="52" Background="#FF7A82F6" FontSize="14" FontWeight="Bold" Click="BtnImgFirst_Click"/>
        <Button x:Name="btnImgLast_Click" Content="&gt;&gt;" HorizontalAlignment="Left" Margin="638,217,0,0" VerticalAlignment="Top" Height="26" Width="52" Background="#FF7A82F6" FontSize="14" FontWeight="Bold" Click="BtnImgLast_Click"/>
        <Button x:Name="btnImgAdd_Click" Content="+" HorizontalAlignment="Left" Margin="581,155,0,0" VerticalAlignment="Top" Height="26" Width="52" Background="#FF7A82F6" FontSize="14" FontWeight="Bold" Click="BtnImgAdd_Click"/>
        <Button x:Name="btnImgDelete_Click" Content="-" HorizontalAlignment="Left" Margin="638,155,0,0" VerticalAlignment="Top" Height="26" Width="52" Background="#FF7A82F6" FontSize="14" FontWeight="Bold" Click="BtnImgDelete_Click"/>
        <Image x:Name="imageViewer" HorizontalAlignment="Left" Height="100" Margin="408,146,0,0" VerticalAlignment="Top" Width="100"/>
        <Label x:Name="labelCountImg" Content="0/0" HorizontalAlignment="Left" Margin="704,187,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
