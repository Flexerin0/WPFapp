<Window x:Class="WpfApp1.FormCatalogClients"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="FormCatalogClients" Height="470" Width="815">
    <Grid Background="#FF99B4D1">
        <Button Click="BtnEdit_Click" Content="Редактировать" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Height="30" Width="370" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Button Click="BtnAdd_Click" Content="Добавить" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="30" Width="200" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Button Click="BtnDelete_Click" Content="Удалить" HorizontalAlignment="Left" Margin="592,10,0,0" VerticalAlignment="Top" Height="30" Width="200" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <TextBox x:Name="tBoxId" HorizontalAlignment="Left" Margin="160,45,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" Background="#FF68ADFF" Height="20"/>
        <TextBox x:Name="tBoxFullName" HorizontalAlignment="Left" Margin="160,70,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" Background="#FF68ADFF" Height="20"/>
        <TextBox x:Name="tBoxPhone" HorizontalAlignment="Left" Margin="160,95,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" Background="#FF68ADFF" Height="20"/>
        <TextBox x:Name="tBoxEmail" HorizontalAlignment="Left" Margin="160,120,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" Background="#FF68ADFF" Height="20"/>
        <TextBox x:Name="tBoxBalance" HorizontalAlignment="Left" Margin="160,172,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" Background="#FF68ADFF" Height="20"/>
        <Label Content="Id" HorizontalAlignment="Left" Margin="10,39,0,0" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
        <Label Content="Полное имя" HorizontalAlignment="Left" Margin="10,64,0,0" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
        <Label Content="Телефон" HorizontalAlignment="Left" Margin="10,89,0,0" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
        <Label Content="Email" HorizontalAlignment="Left" Margin="10,114,0,0" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
        <Label Content="Баланс" HorizontalAlignment="Left" Margin="10,166,0,0" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
        <Label Content="Описание" HorizontalAlignment="Left" Margin="284,118,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
        <TextBox x:Name="tBoxDescription" HorizontalAlignment="Left" Margin="366,48,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="426" Background="#FF68ADFF" Height="169"/>
        <Button Click="BtnSave_Click" Content="Применить" HorizontalAlignment="Left" Margin="10,399,0,0" VerticalAlignment="Top" Height="30" Width="200" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Button Click="BtnExit_Click" Content="Выход" HorizontalAlignment="Left" Margin="605,399,0,0" VerticalAlignment="Top" Height="30" Width="200" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <ListBox DisplayMemberPath="FullName" x:Name="ListBoxClients" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,227,10,45" Background="#FF68ADFF" SelectionChanged="ListBoxClients_SelectionChanged" IsSynchronizedWithCurrentItem="True"/>
        <Label Content="Дата регистрации" HorizontalAlignment="Left" Margin="10,140,0,0" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
        <Label Content="Бонусные баллы" HorizontalAlignment="Left" Margin="10,191,0,0" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
        <TextBox x:Name="tBoxBonusPoints" HorizontalAlignment="Left" Margin="160,197,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" Background="#FF68ADFF" Height="20"/>
        <DatePicker x:Name="DatePickerRegistrationDate" HorizontalAlignment="Left" Margin="160,145,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
