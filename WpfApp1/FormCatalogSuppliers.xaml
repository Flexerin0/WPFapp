<Window x:Class="WpfApp1.FormCatalogSuppliers"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="FormCatalogSuppliers" Height="450" Width="800">
    <Grid Background="#FF99B4D1">
        <Button Click="BtnAdd_Click" Content="Добавить" HorizontalAlignment="Left" Margin="18,220,0,0" VerticalAlignment="Top" Height="30" Width="148" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Button Click="BtnSave_Click" Content="Сохранить" HorizontalAlignment="Left" Margin="18,255,0,0" VerticalAlignment="Top" Height="30" Width="148" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Button Click="BtnDelete_Click" Content="Удалить" HorizontalAlignment="Left" Margin="205,220,0,0" VerticalAlignment="Top" Height="30" Width="148" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Button Click="BtnEdit_Click" Content="Редактировать" HorizontalAlignment="Left" Margin="205,255,0,0" VerticalAlignment="Top" Height="30" Width="148" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Button Click="BtnExit_Click" Content="Выход" HorizontalAlignment="Left" Margin="115,344,0,0" VerticalAlignment="Top" Height="30" Width="148" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Label Content="Id"
            Margin="18,30,0,0"
            VerticalAlignment="Top"
            FontSize="20" HorizontalAlignment="Left" Height="34" Width="30"/>
        <TextBox x:Name="tBoxId"
            Margin="115,30,645,0"
            Height="34"
            VerticalAlignment="Top"
            FontSize="18" Background="#FF68ADFF"/>
        <Label Content="Имя"
            Margin="18,64,0,0"
            VerticalAlignment="Top"
            FontSize="20" HorizontalAlignment="Left" Height="34" Width="55"/>
        <TextBox x:Name="tBoxName"
            Margin="115,69,447,0"
            Height="34"
            VerticalAlignment="Top"
            FontSize="18" Background="#FF68ADFF"/>
        <Label Content="Телефон"
            Margin="18,103,0,0"
            VerticalAlignment="Top"
            FontSize="20" HorizontalAlignment="Left" Height="34" Width="92"/>
        <Label Content="Email"
            Margin="18,142,0,0"
            VerticalAlignment="Top"
            FontSize="20" HorizontalAlignment="Left" Height="34" Width="62"/>
        <Label Content="Дата регистрации"
            Margin="18,181,0,0"
            VerticalAlignment="Top"
            FontSize="20" HorizontalAlignment="Left" Height="34" Width="180"/>
        <DatePicker x:Name="DatePickerRegistrationDate" HorizontalAlignment="Left" Margin="203,191,0,0" VerticalAlignment="Top" Width="150"/>
        <TextBox x:Name="tBoxEmail"
            Margin="115,147,447,0"
            Height="34"
            VerticalAlignment="Top"
            FontSize="18" Background="#FF68ADFF"/>
        <TextBox x:Name="tBoxPhone"
            Margin="115,108,447,0"
            Height="34"
            VerticalAlignment="Top"
            FontSize="18" Background="#FF68ADFF"/>
        <ListBox DisplayMemberPath="Name" SelectionChanged="ListBoxSuppliers_SelectionChanged" x:Name="ListBoxSuppliers" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="358,10,10,10" Background="#FF68ADFF"/>

    </Grid>
</Window>
