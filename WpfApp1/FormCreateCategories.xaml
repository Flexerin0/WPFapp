<Window x:Class="WpfApp1.FormCreateCategories"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="FormCreateCategories" Height="470" Width="815">
    <Grid Background="#FF99B4D1" Width="800" Margin="0,0,0,-6">
        <Label Content="Название категории"
            Margin="65,18,0,0"
            VerticalAlignment="Top"
            FontSize="20" Height="73" HorizontalAlignment="Left" HorizontalContentAlignment="Center" Width="270"/>
        <Label Content="Описание"
            Margin="147,96,0,0"
            VerticalAlignment="Top"
            FontSize="20" HorizontalAlignment="Left"/>
        <TextBox x:Name="tBoxName"
            Margin="100,57,500,0"
            Height="34"
            VerticalAlignment="Top"
            FontSize="18" Background="#FF68ADFF"/>
        <TextBox x:Name="tBoxDescription"
            Margin="30,133,435,0"
            Height="141"
            VerticalAlignment="Top"
            FontSize="18" Background="#FF68ADFF"/>
        <ListBox DisplayMemberPath="Name" x:Name="listBoxCategories" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="370,10,10,10" Background="#FF68ADFF" SelectionChanged="ListBox_SelectionChanged" IsSynchronizedWithCurrentItem="True"/>
        <Button Click="BtnAdd_Click" Content="Добавить" HorizontalAlignment="Left" Margin="30,281,0,0" VerticalAlignment="Top" Height="30" Width="148" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Button Click="BtnSave_Click" Content="Сохранить" HorizontalAlignment="Left" Margin="30,316,0,0" VerticalAlignment="Top" Height="30" Width="148" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Button Click="BtnDelete_Click" Content="Удалить" HorizontalAlignment="Left" Margin="217,281,0,0" VerticalAlignment="Top" Height="30" Width="148" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Button Click="BtnEdit_Click" Content="Редактировать" HorizontalAlignment="Left" Margin="217,316,0,0" VerticalAlignment="Top" Height="30" Width="148" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Button Click="BtnExit_Click" Content="Выход" HorizontalAlignment="Left" Margin="124,350,0,0" VerticalAlignment="Top" Height="30" Width="148" Background="#FF7A82F6" FontSize="18" FontWeight="Bold"/>
        <Label Content="Id"
            Margin="10,57,0,0"
            VerticalAlignment="Top"
            FontSize="20" HorizontalAlignment="Left" Height="34" Width="30"/>
        <TextBox x:Name="tBoxId"
            Margin="40,57,720,0"
            Height="34"
            VerticalAlignment="Top"
            FontSize="18" Background="#FF68ADFF"/>

    </Grid>
</Window>
